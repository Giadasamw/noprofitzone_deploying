{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "No Profit Zone Design System",
  "source": "src/app/globals.css",
  "color": {
    "paper":         { "value": "#faf6ec", "role": "background / carta" },
    "paper-2":       { "value": "#f3e0d0", "role": "superficie secondaria" },
    "ink":           { "value": "#4a4744", "role": "testo primario" },
    "ink-soft":      { "value": "#5a544d", "role": "testo secondario" },
    "muted":         { "value": "#8a8175", "role": "label / eyebrow / meta" },
    "line":          { "value": "#e3d9c4", "role": "bordi" },
    "line-soft":     { "value": "#ece3d2", "role": "divisori tenui" },
    "accent":        { "value": "#cc5a2c", "role": "terracotta — azione" },
    "accent-deep":   { "value": "#a8451f", "role": "accento hover" },
    "accent-yellow": { "value": "#f5d76a", "role": "decorativo" },
    "accent-lilac":  { "value": "#e0a4e8", "role": "decorativo" }
  },
  "gradient": {
    "primary": { "value": "radial-gradient(120% 130% at 70% 30%, #f5d76a 0%, #f3a07a 35%, #e0a4e8 75%, #cdb9e8 100%)" },
    "soft":    { "value": "radial-gradient(120% 130% at 30% 30%, #fbe8b6 0%, #f5c4a8 40%, #e7c0eb 75%, #d9c5e6 100%)" }
  },
  "font": {
    "family": {
      "serif": { "value": "\"Mackinac\", \"Iowan Old Style\", Georgia, serif", "use": "titoli, display, enfasi corsivo" },
      "sans":  { "value": "\"Mallory\", \"Helvetica Neue\", Helvetica, Arial, sans-serif", "use": "testo, UI, eyebrow" }
    },
    "weight": { "book": { "value": 400 }, "bold": { "value": 700 } },
    "scale": {
      "display": { "value": "clamp(2.1rem, 3.6vw, 3.15rem)", "family": "serif", "weight": 700, "lineHeight": 1.04, "letterSpacing": "-0.018em" },
      "h2":      { "value": "clamp(1.4rem, 2.2vw, 2.1rem)",  "family": "serif", "weight": 700, "lineHeight": 1.05, "letterSpacing": "-0.012em" },
      "h3":      { "value": "1.6rem",  "family": "serif", "weight": 700, "lineHeight": 1.1,  "letterSpacing": "-0.01em" },
      "h4":      { "value": "1.05rem", "family": "serif", "weight": 700, "lineHeight": 1.15, "letterSpacing": "-0.005em" },
      "lead":    { "value": "1rem",    "family": "sans",  "weight": 400, "lineHeight": 1.6,  "letterSpacing": "-0.005em" },
      "body":    { "value": "0.85rem", "family": "sans",  "weight": 400, "lineHeight": 1.6 },
      "small":   { "value": "0.78rem", "family": "sans",  "weight": 400, "lineHeight": 1.55 },
      "label":   { "value": "0.7rem",  "family": "sans",  "weight": 400, "lineHeight": 1, "letterSpacing": "0.24em", "textTransform": "uppercase" },
      "nav":     { "value": "0.75rem", "family": "sans",  "weight": 400, "letterSpacing": "0.04em", "textTransform": "uppercase" }
    }
  },
  "space": {
    "base": "4px",
    "scale": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "14": "56px", "16": "64px", "24": "96px", "30": "120px" },
    "section": { "lg": "140px", "md": "100px", "sm": "60px" }
  },
  "layout": {
    "containerMax": "1240px",
    "containerPad": "72px",
    "containerPadMobile": "24px",
    "measure": "768px",
    "breakpointMobile": "768px"
  },
  "radius": { "s": "12px", "m": "16px", "l": "20px", "xl": "24px", "pill": "999px" },
  "border": { "line": "1px solid #e3d9c4", "accent": "1.5px solid #cc5a2c" },
  "effect": {
    "photo": { "value": "grayscale(1) contrast(1.04)", "use": "foto in bianco e nero" },
    "headerBlur": { "value": "blur(10px)", "background": "rgba(250,246,236,0.88)" }
  }
}
</content>
